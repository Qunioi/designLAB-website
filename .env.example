# 僅供後端 /api/r2-upload-url.js 使用，請勿加上 VITE_ 前綴
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=designlab-website
R2_PUBLIC_URL=https://pub-cfdfde59ceb44b798935e3dc4a29de0d.r2.dev

# 部署在 /designLAB/ 子目錄且 API 與網站同源時可留白；若 API 在其他網域，請填 API 的資料夾網址
VITE_UPLOAD_API_URL=https://designlab-r2-api.bbinvd.workers.dev

# Apps Script Web App 的 /exec 網址（見 apps-script/README.md 的部署步驟）。
# 必填——沒有內建預設值，也不支援在「設定」頁面手動覆寫，
# 留空則整個 Google Sheets 整合會直接關閉（退回純 localStorage 模式）。
VITE_SHEETS_URL=https://script.google.com/macros/s/xxxxx/exec
